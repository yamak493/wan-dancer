# Copy to .env (next to setup.sh) or to /workspace/wan-dancer/.env on the
# persistent volume. setup.sh sources both, the volume one last.
# Everything here is optional.

# --- HuggingFace -------------------------------------------------------------
# Only needed if one of the model repos becomes gated/licence-accept.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# --- What to download --------------------------------------------------------
# Manifest groups. "core" is required; "speed" adds the LightX2V lightning LoRA.
# WD_MODEL_GROUPS=core,speed
# Also fetch the `optional` group (fp16 text encoder, +11 GB).
# WD_DOWNLOAD_OPTIONAL=0
# Text encoder precision: fp8 (default, ~6.7 GB) or fp16 (~11 GB).
# WD_TEXT_ENCODER=fp8

# --- Where things live -------------------------------------------------------
# Override ComfyUI detection.
# COMFY_DIR=/ComfyUI
# The interpreter ComfyUI runs under. Auto-detected (including virtualenvs);
# set this only if pip installs land in the wrong environment.
# COMFY_PYTHON=/venv/bin/python
# Persistent volume mount point (must match the RunPod template).
# WD_PERSIST_ROOT=/workspace
# Force a model directory, bypassing volume detection.
# WD_MODEL_ROOT=/workspace/wan-dancer/models

# --- Setup behaviour ---------------------------------------------------------
# git pull ComfyUI to latest on boot (needed for native Wan-Dancer nodes).
# WD_UPDATE_COMFYUI=1
# WD_INSTALL_CUSTOM_NODES=1
# WD_FETCH_WORKFLOWS=1

# --- Runtime -----------------------------------------------------------------
# WD_COMFY_PORT=8188
# WD_COMFY_HOST=0.0.0.0
# auto | highvram | normalvram | lowvram
# WD_VRAM_MODE=auto
# Extra ComfyUI CLI flags, space separated.
# WD_COMFY_EXTRA_ARGS=--preview-method auto
# Hand off to the base image's own start script (JupyterLab etc.) instead of
# launching ComfyUI directly.
# WD_USE_IMAGE_ENTRYPOINT=0
